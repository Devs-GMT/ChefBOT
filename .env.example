# ChefBOT environment (placeholders only — never commit real secrets)

# --- Frontend (Vercel project settings or .env.local) ---
# ChefBOT contract address. This is the verified TESTNET (chain 968)
# deployment — redeployed with the PRD §5 `getDishes()` and checked on-chain 2026-10-18 (recipeKey("Fried Rice")
# matches the repo test anchor). For mainnet, replace after the Remix
# deploy on chain 677 and set NEXT_PUBLIC_CHEFBOT_CHAIN_ID=677.
NEXT_PUBLIC_CHEFBOT_CONTRACT_ADDRESS=0x939878F4aA5564B91aFa1e8758A100F14AAbcB85
# Cloudflare Worker base URL serving POST /recipes (no trailing slash).
NEXT_PUBLIC_RECIPES_API_URL=http://127.0.0.1:8787
# Target chain for wallet add/switch and cookIt. Must match the network
# the address above lives on: 968 (testnet) or 677 (mainnet, default).
NEXT_PUBLIC_CHEFBOT_CHAIN_ID=968

# --- Cloudflare Worker secret (wrangler secret put GEMINI_API_KEY; local dev: worker/.dev.vars) ---
# Free key from Google AI Studio (https://aistudio.google.com/apikey).
GEMINI_API_KEY=

# --- Cloudflare Worker plain vars (worker/wrangler.jsonc "vars") ---
# Comma-separated CORS allowlist of exact origins.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
# Requests allowed per IP per hour (default 20).
RATE_LIMIT_PER_HOUR=20
# Gemini model id (free tier). Optional thinking level, e.g. minimal.
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_THINKING_LEVEL=
