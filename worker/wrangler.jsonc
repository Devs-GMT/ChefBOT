{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chefbot-recipes",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Public URL: https://chefbot-recipes.<account>.workers.dev. Preview URLs are
  // off — Cloudflare does not serve them for Workers with a Durable Object.
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    // Add the production site (Vercel URL + custom domain) before `wrangler deploy`.
    "CORS_ALLOWED_ORIGINS": "http://localhost:3000,http://127.0.0.1:3000",
    "RATE_LIMIT_PER_HOUR": "20",
    "GEMINI_MODEL": "gemini-3.5-flash-lite"
    // Optional: "GEMINI_THINKING_LEVEL": "minimal" (verify against the live API first).
    // Optional: "GEMINI_SCAN_MODEL" / "GEMINI_SCAN_THINKING_LEVEL" for POST /scan only.
    // Measured 2026-10-18 (npm run eval:scan): gemini-3.5-flash on the free tier hit
    // 429/503/504 on most calls and was no more accurate, so scans stay on GEMINI_MODEL.
    // Secret (never in this file): wrangler secret put GEMINI_API_KEY
  },
  // Per-IP hourly limiter: one SQLite-backed Durable Object per client IP.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  "observability": {
    "enabled": true
  }
}
