{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chefbot-recipes",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // Public URL: https://chefbot-recipes.<account>.workers.dev. Preview URLs are
  // off — Cloudflare does not serve them for Workers with a Durable Object.
  "workers_dev": true,
  "preview_urls": false,
  // api.chef-bot.my.id: *.workers.dev is DNS-blocked by some Indonesian ISPs
  // (XL). Needs the chef-bot.my.id zone on this Cloudflare account.
  "routes": [{ "pattern": "api.chef-bot.my.id", "custom_domain": true }],
  "vars": {
    // Add the production site (Vercel URL + custom domain) before `wrangler deploy`.
    "CORS_ALLOWED_ORIGINS": "https://chef-bot.my.id,https://www.chef-bot.my.id,https://chef-bot-kappa.vercel.app,http://localhost:3000,http://127.0.0.1:3000",
    "RATE_LIMIT_PER_HOUR": "20",
    "GEMINI_MODEL": "gemini-3.5-flash-lite",
    // Recipe archive proof: a POST /dishes must cite a tx whose receipt has
    // this contract's Cooked event. Switch both to mainnet (677) at launch.
    "CHAIN_RPC_URL": "https://rpc.botchain.ai",
    "CHEFBOT_CONTRACT_ADDRESS": "0x0d58c8dB2F9Cb482be94dCad9025A25f0940fA7D"
    // Optional: "GEMINI_THINKING_LEVEL": "minimal" (verify against the live API first).
    // Optional: "GEMINI_SCAN_MODEL" / "GEMINI_SCAN_THINKING_LEVEL" for POST /scan only.
    // Measured 2026-10-18 (npm run eval:scan): gemini-3.5-flash on the free tier hit
    // 429/503/504 on most calls and was no more accurate, so scans stay on GEMINI_MODEL.
    // Secret (never in this file): wrangler secret put GEMINI_API_KEY
  },
  // Per-IP hourly limiter: one SQLite-backed Durable Object per client IP.
  "durable_objects": {
    "bindings": [{ "name": "RATE_LIMITER", "class_name": "RateLimiter" }]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RateLimiter"] }],
  // Recipe archive. No id: `wrangler deploy` provisions the namespace on
  // first deploy; `wrangler dev` uses a local one.
  "kv_namespaces": [{ "binding": "DISHES" }],
  // Run next to the Gemini API: from some Cloudflare edges Google answers
  // HTTP 400 (location not supported) — seen live as intermittent /scan
  // failures. Pinning placement gives a supported, consistent egress.
  "placement": { "mode": "targeted", "hostname": "generativelanguage.googleapis.com" },
  "observability": {
    "enabled": true
  }
}
